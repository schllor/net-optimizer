# ============================================================
#  网络优化助手 —— Git 忽略规则
#  以下内容包含本机真实网络信息（SSID / MAC / IP / 使用日志）
#  或体积过大，严禁提交到公开仓库
# ============================================================

# ---------- 运行期数据：真实网络隐私 ----------
data/
源代码/data/
**/wifi_diag.txt
**/history.json
**/device_aliases.json

# ---------- 打包产物与构建缓存（约 700MB）----------
build/
build_*/
dist/
dist_*/
源代码/build/
源代码/build_*/
源代码/dist/
源代码/dist_*/
__pycache__/
*.py[cod]
.pytest_cache/

# ---------- 专有字体：微软/中易 SimHei，不公开再分发 ----------
源代码/fonts/*.ttf
源代码/fonts/*.ttc
源代码/fonts/*.otf

# ---------- 虚拟环境 ----------
.venv/
venv/
env/

# ---------- 编辑器 / 操作系统 ----------
.vscode/
.idea/
*.swp
*.log
Thumbs.db
desktop.ini
.DS_Store
